<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:id="@+id/title"
            style="@style/Widget.ProfitNet.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:text="@string/consents_title" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/termsCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/consent_terms"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/privacyCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/consent_privacy"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/consents_required_hint"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/optionalHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/consents_optional_header"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnBackground" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/marketingCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/consent_marketing"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/analyticsCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/consent_analytics"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/aiCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:minHeight="@dimen/min_touch_target"
            android:text="@string/consent_ai"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/message"
            style="@style/Widget.ProfitNet.InlineMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/spacing_lg" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/loading"
            android:indeterminate="true"
            android:visibility="invisible" />

        <Button
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:enabled="false"
            android:text="@string/action_continue" />

    </LinearLayout>
</ScrollView>
