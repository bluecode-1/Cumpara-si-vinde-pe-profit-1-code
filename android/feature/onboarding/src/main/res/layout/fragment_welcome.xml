<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:id="@+id/title"
            style="@style/Widget.ProfitNet.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/welcome_title"
            android:textAppearance="?attr/textAppearanceDisplaySmall" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:gravity="center_vertical"
            android:minHeight="@dimen/min_touch_target"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/onboarding_point_icon_size"
                android:layout_height="@dimen/onboarding_point_icon_size"
                android:background="@drawable/bg_onboarding_point_icon"
                android:importantForAccessibility="no"
                android:padding="@dimen/onboarding_point_icon_padding"
                app:srcCompat="@drawable/ic_onboarding_passport"
                app:tint="?attr/colorOnPrimaryContainer" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_weight="1"
                android:text="@string/welcome_point_passport"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnBackground" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:minHeight="@dimen/min_touch_target"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/onboarding_point_icon_size"
                android:layout_height="@dimen/onboarding_point_icon_size"
                android:background="@drawable/bg_onboarding_point_icon"
                android:importantForAccessibility="no"
                android:padding="@dimen/onboarding_point_icon_padding"
                app:srcCompat="@drawable/ic_onboarding_handover"
                app:tint="?attr/colorOnPrimaryContainer" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_weight="1"
                android:text="@string/welcome_point_handover"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnBackground" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:minHeight="@dimen/min_touch_target"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/onboarding_point_icon_size"
                android:layout_height="@dimen/onboarding_point_icon_size"
                android:background="@drawable/bg_onboarding_point_icon"
                android:importantForAccessibility="no"
                android:padding="@dimen/onboarding_point_icon_padding"
                app:srcCompat="@drawable/ic_onboarding_wanted"
                app:tint="?attr/colorOnPrimaryContainer" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_weight="1"
                android:text="@string/welcome_point_wanted"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnBackground" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/spacing_lg" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_cta" />

    </LinearLayout>
</ScrollView>
