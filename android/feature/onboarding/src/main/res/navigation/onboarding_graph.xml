<?xml version="1.0" encoding="utf-8"?>
<!--
    Onboarding flow: Welcome → Phone → Code → Consents → Name → Location → Interests.
    The deep links are in-app only (used by the app module to enter or resume the flow).
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/onboarding_graph"
    app:startDestination="@id/welcomeFragment">

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="ro.profitnet.app.feature.onboarding.ui.welcome.WelcomeFragment"
        tools:layout="@layout/fragment_welcome">
        <deepLink app:uri="profitnet://onboarding" />
        <action
            android:id="@+id/action_welcome_to_phone"
            app:destination="@id/phoneFragment" />
    </fragment>

    <fragment
        android:id="@+id/phoneFragment"
        android:name="ro.profitnet.app.feature.onboarding.ui.phone.PhoneFragment"
        tools:layout="@layout/fragment_phone">
        <action
            android:id="@+id/action_phone_to_code"
            app:destination="@id/codeFragment" />
    </fragment>

    <fragment
        android:id="@+id/codeFragment"
        android:name="ro.profitnet.app.feature.onboarding.ui.code.CodeFragment"
        tools:layout="@layout/fragment_code">
        <argument
            android:name="phone"
            app:argType="string" />
        <argument
            android:name="challengeId"
            app:argType="string" />
        <argument
            android:name="retryAfterSeconds"
            app:argType="integer" />
        <!-- Once signed in, the sign-in screens leave the back stack. -->
        <action
            android:id="@+id/action_code_to_consents"
            app:destination="@id/consentsFragment"
            app:popUpTo="@id/welcomeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/consentsFragment"
        android:name="ro.profitnet.app.feature.onboarding.ui.consents.ConsentsFragment"
        tools:layout="@layout/fragment_consents">
        <deepLink app:uri="profitnet://onboarding/consents" />
        <action
            android:id="@+id/action_consents_to_name"
            app:destination="@id/nameFragment" />
    </fragment>

    <fragment
        android:id="@+id/nameFragment"
        android:name="ro.profitnet.app.feature.onboarding.ui.name.NameFragment"
        tools:layout="@layout/fragment_name">
        <deepLink app:uri="profitnet://onboarding/name" />
        <action
            android:id="@+id/action_name_to_location"
            app:destination="@id/locationFragment" />
    </fragment>

    <fragment
        android:id="@+id/locationFragment"
        android:name="ro.profitnet.app.feature.onboarding.ui.location.LocationFragment"
        tools:layout="@layout/fragment_location">
        <deepLink app:uri="profitnet://onboarding/location" />
        <action
            android:id="@+id/action_location_to_interests"
            app:destination="@id/interestsFragment" />
    </fragment>

    <fragment
        android:id="@+id/interestsFragment"
        android:name="ro.profitnet.app.feature.onboarding.ui.interests.InterestsFragment"
        tools:layout="@layout/fragment_interests">
        <deepLink app:uri="profitnet://onboarding/interests" />
    </fragment>
</navigation>
