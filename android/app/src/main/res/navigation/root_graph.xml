<?xml version="1.0" encoding="utf-8"?>
<!--
    Root graph: one nested graph per feature. Features do not know each other; they navigate
    across through the in-app deep links declared in their graphs (see DeepLinks).
    The start destination is replaced in MainActivity depending on the session.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_graph"
    app:startDestination="@id/onboarding_graph">

    <include app:graph="@navigation/onboarding_graph" />

    <include app:graph="@navigation/home_graph" />
</navigation>
