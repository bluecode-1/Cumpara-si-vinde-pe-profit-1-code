<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Buttons: pill shape, full 48dp height so the visible shape is the touch target. -->
    <style name="Widget.ProfitNet.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.ProfitNet.Pill</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <style name="Widget.ProfitNet.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.ProfitNet.Pill</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <style name="Widget.ProfitNet.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.ProfitNet.Pill</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <style name="Widget.ProfitNet.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.ProfitNet.Pill</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <style name="Widget.ProfitNet.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.ProfitNet.Small</item>
    </style>

    <!-- Screen scaffolding shared by the feature layouts. -->
    <style name="Widget.ProfitNet.ScreenTitle" parent="">
        <item name="android:textAppearance">?attr/textAppearanceHeadlineSmall</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="Widget.ProfitNet.ScreenSubtitle" parent="">
        <item name="android:layout_marginTop">@dimen/spacing_sm</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Inline error or notice; a polite live region so screen readers announce changes. -->
    <style name="Widget.ProfitNet.InlineMessage" parent="">
        <item name="android:layout_marginTop">@dimen/spacing_md</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorError</item>
        <item name="android:accessibilityLiveRegion">polite</item>
    </style>
</resources>
