<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        "Livada" theme: Material 3 with colours, type and shapes from design/tokens.json.
        Colours switch between light and dark through values/ and values-night/colors.xml.
    -->
    <style name="Theme.ProfitNet" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colour roles -->
        <item name="colorPrimary">@color/livada_primary</item>
        <item name="colorOnPrimary">@color/livada_on_primary</item>
        <item name="colorPrimaryContainer">@color/livada_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/livada_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/livada_inverse_primary</item>
        <item name="colorSecondary">@color/livada_secondary</item>
        <item name="colorOnSecondary">@color/livada_on_secondary</item>
        <item name="colorSecondaryContainer">@color/livada_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/livada_on_secondary_container</item>
        <!-- The tokens define no tertiary role; reuse secondary instead of the Material default. -->
        <item name="colorTertiary">@color/livada_secondary</item>
        <item name="colorOnTertiary">@color/livada_on_secondary</item>
        <item name="colorTertiaryContainer">@color/livada_secondary_container</item>
        <item name="colorOnTertiaryContainer">@color/livada_on_secondary_container</item>
        <item name="android:colorBackground">@color/livada_background</item>
        <item name="colorOnBackground">@color/livada_on_background</item>
        <item name="colorSurface">@color/livada_surface</item>
        <item name="colorOnSurface">@color/livada_on_surface</item>
        <item name="colorSurfaceVariant">@color/livada_surface_container</item>
        <item name="colorOnSurfaceVariant">@color/livada_on_surface_variant</item>
        <item name="colorSurfaceDim">@color/livada_surface_container</item>
        <item name="colorSurfaceBright">@color/livada_surface</item>
        <item name="colorSurfaceContainerLowest">@color/livada_surface</item>
        <item name="colorSurfaceContainerLow">@color/livada_surface_container</item>
        <item name="colorSurfaceContainer">@color/livada_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/livada_surface_container</item>
        <item name="colorSurfaceContainerHighest">@color/livada_surface_container</item>
        <item name="colorSurfaceInverse">@color/livada_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/livada_inverse_on_surface</item>
        <item name="colorOutline">@color/livada_outline</item>
        <item name="colorOutlineVariant">@color/livada_outline_variant</item>
        <item name="colorError">@color/livada_error</item>
        <item name="colorOnError">@color/livada_on_error</item>
        <item name="colorErrorContainer">@color/livada_error_container</item>
        <item name="colorOnErrorContainer">@color/livada_on_error_container</item>

        <!-- Typography -->
        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.ProfitNet.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.ProfitNet.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.ProfitNet.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.ProfitNet.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.ProfitNet.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.ProfitNet.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.ProfitNet.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.ProfitNet.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.ProfitNet.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.ProfitNet.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.ProfitNet.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.ProfitNet.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.ProfitNet.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.ProfitNet.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.ProfitNet.LabelSmall</item>

        <!-- Shapes -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.ProfitNet.Small</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.ProfitNet.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.ProfitNet.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.ProfitNet.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.ProfitNet.Large</item>

        <!-- Components -->
        <item name="materialButtonStyle">@style/Widget.ProfitNet.Button</item>
        <item name="borderlessButtonStyle">@style/Widget.ProfitNet.Button.Text</item>
        <item name="textInputStyle">@style/Widget.ProfitNet.TextInputLayout</item>
    </style>
</resources>
