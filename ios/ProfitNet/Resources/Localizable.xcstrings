{
  "sourceLanguage": "ro",
  "strings": {
    "welcome_title": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucrurile bune merită o a doua casă"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good things deserve a second home"
          }
        }
      }
    },
    "welcome_point_passport": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare obiect are un pașaport cu istoricul lui"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every item has a passport with its history"
          }
        }
      }
    },
    "welcome_point_handover": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plătești în siguranță și primești banii la predare"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay safely and get your money at handover"
          }
        }
      }
    },
    "welcome_point_wanted": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spui ce cauți și primești potriviri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say what you are looking for and get matches"
          }
        }
      }
    },
    "welcome_cta": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get started"
          }
        }
      }
    },
    "phone_title": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Care este numărul tău de telefon?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is your phone number?"
          }
        }
      }
    },
    "phone_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îți trimitem un cod prin SMS ca să-ți confirmăm numărul."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We will text you a code to confirm your number."
          }
        }
      }
    },
    "phone_label": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Număr de telefon"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone number"
          }
        }
      }
    },
    "phone_error_invalid": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu un număr de mobil valid, de exemplu 0712 345 678."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid mobile number, for example 0712 345 678."
          }
        }
      }
    },
    "phone_cta": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimite codul"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send the code"
          }
        }
      }
    },
    "code_title": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu codul primit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the code you received"
          }
        }
      }
    },
    "code_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am trimis un cod din 6 cifre la %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We sent a 6-digit code to %@."
          }
        }
      }
    },
    "code_label": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cod de verificare"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification code"
          }
        }
      }
    },
    "code_resend": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrimite codul"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resend the code"
          }
        }
      }
    },
    "code_resend_in": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți retrimite codul în %lld s"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can resend the code in %lld s"
          }
        }
      }
    },
    "consents_title": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înainte să continui"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you continue"
          }
        }
      }
    },
    "consent_terms": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt de acord cu Termenii și condițiile"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I agree to the Terms and Conditions"
          }
        }
      }
    },
    "consent_privacy": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am citit Politica de confidențialitate"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have read the Privacy Policy"
          }
        }
      }
    },
    "consent_marketing": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vreau să primesc noutăți și oferte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I want to receive news and offers"
          }
        }
      }
    },
    "consent_analytics": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajut la îmbunătățirea aplicației cu date de utilizare anonime"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I help improve the app with anonymous usage data"
          }
        }
      }
    },
    "consent_ai": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permit analiza automată a fotografiilor pentru sugestii de titlu și categorie"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I allow automatic analysis of photos for title and category suggestions"
          }
        }
      }
    },
    "consents_required_hint": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Primele două sunt necesare pentru a folosi aplicația."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first two are required to use the app."
          }
        }
      }
    },
    "consents_optional_header": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțional"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional"
          }
        }
      }
    },
    "name_title": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cum vrei să-ți spunem?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should we call you?"
          }
        }
      }
    },
    "name_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele apare în profilul tău și în conversații."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name appears on your profile and in conversations."
          }
        }
      }
    },
    "name_label": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nume afișat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display name"
          }
        }
      }
    },
    "name_error_length": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele trebuie să aibă între 2 și 40 de caractere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name must be between 2 and 40 characters long."
          }
        }
      }
    },
    "location_title": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unde ești de obicei?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where are you usually?"
          }
        }
      }
    },
    "location_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îți arătăm ce e aproape de tine. Păstrăm doar zona aproximativă, nu adresa."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We show you what is near you. We only keep the approximate area, not your address."
          }
        }
      }
    },
    "location_use_mine": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește locația mea"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use my location"
          }
        }
      }
    },
    "location_pick_city": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aleg orașul"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll choose the city"
          }
        }
      }
    },
    "location_denied": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu avem acces la locație. Poți alege orașul din listă."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We don't have access to your location. You can choose your city from the list."
          }
        }
      }
    },
    "interests_title": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce te interesează?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What are you interested in?"
          }
        }
      }
    },
    "interests_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege câteva categorii. Le poți schimba oricând."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a few categories. You can change them anytime."
          }
        }
      }
    },
    "interests_skip": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sari peste"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip"
          }
        }
      }
    },
    "action_continue": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuă"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        }
      }
    },
    "action_finish": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gata"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "home_greeting": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bună, %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, %@"
          }
        }
      }
    },
    "home_placeholder": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecranul principal este în lucru."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The home screen is under construction."
          }
        }
      }
    },
    "action_logout": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieși din cont"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log out"
          }
        }
      }
    },
    "error_otp_invalid": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Codul nu este corect sau a expirat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is incorrect or has expired."
          }
        }
      }
    },
    "error_rate_limited": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea multe încercări. Încearcă din nou peste câteva minute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Try again in a few minutes."
          }
        }
      }
    },
    "error_network": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există conexiune la internet. Verifică rețeaua și încearcă din nou."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection. Check your network and try again."
          }
        }
      }
    },
    "error_generic": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceva nu a mers. Încearcă din nou."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Try again."
          }
        }
      }
    }
  },
  "version": "1.0"
}